<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>琴琴课表 🎻</title>
<style>
@font-face{
  font-family:'ZCOOL';
  src:url('assets/zcool.woff2') format('woff2');
  font-display:swap;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'ZCOOL','Yuanti SC','PingFang SC','Microsoft YaHei',sans-serif;
  background:#1b1522;
  background-image:
    radial-gradient(circle at 12% 8%, rgba(255,143,179,.10) 0 220px, transparent 240px),
    radial-gradient(circle at 88% 30%, rgba(150,190,255,.08) 0 200px, transparent 220px),
    radial-gradient(circle at 40% 90%, rgba(255,143,179,.07) 0 260px, transparent 280px);
  color:#f2e9f0;
  padding:44px 30px 70px;
}
.wrap{max-width:1760px;margin:0 auto}
.hero{text-align:center;margin-bottom:14px}
.hero h1{font-size:40px;color:#ffb9d4;letter-spacing:2px}
.hero h1 .violin{filter:drop-shadow(0 4px 10px rgba(255,109,157,.5))}
.hero p{margin-top:10px;font-size:16px;color:#c9b3c4}
.sec{margin-top:52px}
.sec-t{font-size:24px;color:#ffc3da;margin-bottom:8px;text-align:center}
.sec-s{font-size:14px;color:#a98ea3;text-align:center;margin-bottom:26px}
.row{display:flex;gap:38px;flex-wrap:wrap;justify-content:center;align-items:flex-start}
.item{display:flex;flex-direction:column;align-items:center;gap:14px}
.item h3{font-size:18px;color:#ffd7e7}
.item p{font-size:13.5px;color:#b39aae;max-width:360px;text-align:center;line-height:1.75}
.tag{display:inline-block;background:#ff6d9d;color:#fff;font-size:12px;border-radius:20px;padding:3px 12px;margin-right:6px}

/* ---------------- 手机框 ---------------- */
.phone{
  width:352px;height:748px;background:#151217;border-radius:58px;padding:10px;
  box-shadow:0 26px 60px rgba(0,0,0,.55), 0 0 0 2px #3a3140, inset 0 0 6px rgba(255,255,255,.08);
  position:relative;flex-shrink:0;
}
.screen{
  width:100%;height:100%;border-radius:48px;overflow:hidden;position:relative;
  background:linear-gradient(160deg,var(--bg1) 0%,var(--bg2) 100%);
  display:flex;flex-direction:column;
}
.island{position:absolute;top:12px;left:50%;transform:translateX(-50%);width:108px;height:29px;background:#151217;border-radius:18px;z-index:60}
.homebar{position:absolute;bottom:7px;left:50%;transform:translateX(-50%);width:128px;height:5px;border-radius:3px;background:var(--hb);z-index:60}
.sb{display:flex;justify-content:space-between;align-items:center;padding:15px 26px 4px;font-size:14px;font-weight:700;color:var(--text);position:relative;z-index:50}
.sb .ic{letter-spacing:1px;font-size:12px}
.deco{position:absolute;z-index:1;user-select:none;pointer-events:none}

/* ---------------- 主题变量 ---------------- */
.t-melody{--bg1:#ffe6ef;--bg2:#fff9fb;--accent:#ff6d9d;--accent2:#ff8fb3;--chip:#ffd7e5;--text:#7c4258;--sub:#b9879b;--card:#ffffff;--hb:rgba(124,66,88,.35)}
.t-kitty{--bg1:#fff3f4;--bg2:#ffffff;--accent:#ff5f7e;--accent2:#ff8298;--chip:#ffdde3;--text:#8c3a4a;--sub:#c08e98;--card:#ffffff;--hb:rgba(140,58,74,.35)}
.t-kuromi{--bg1:#2e2837;--bg2:#403a4c;--accent:#c79bee;--accent2:#a97fe0;--chip:#4a4258;--text:#f3ecfb;--sub:#a997c2;--card:#463f54;--hb:rgba(243,236,251,.4)}
.t-cinnamo{--bg1:#e7f3fe;--bg2:#fbfdff;--accent:#5aa9e6;--accent2:#82bff0;--chip:#d3e8fa;--text:#3d6584;--sub:#7d9cb5;--card:#ffffff;--hb:rgba(61,101,132,.35)}

/* ---------------- 通用组件 ---------------- */
.pagehead{display:flex;justify-content:space-between;align-items:center;padding:10px 20px 6px;position:relative;z-index:2}
.pagehead .dt{font-size:13px;color:var(--sub)}
.pagehead h2{font-size:25px;color:var(--text);margin-top:2px}
.pagehead .sticker{width:58px;height:58px;border-radius:50%;background:#fff;box-shadow:0 4px 12px rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;overflow:hidden}
.pill{display:inline-flex;align-items:center;gap:4px;background:var(--chip);color:var(--text);border-radius:20px;padding:4px 12px;font-size:12.5px}
.pill.acc{background:var(--accent);color:#fff}
.card{background:var(--card);border-radius:24px;box-shadow:0 6px 18px rgba(150,100,125,.10)}
.tabbar{
  margin-top:auto;position:relative;z-index:5;
  display:flex;justify-content:space-around;align-items:center;
  background:rgba(255,255,255,.82);backdrop-filter:blur(8px);
  padding:10px 8px 20px;border-top:1.5px solid rgba(0,0,0,.04);
}
.t-kuromi .tabbar{background:rgba(70,63,84,.82)}
.tab{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;color:var(--sub);width:64px;padding:5px 0;border-radius:16px}
.tab .ti{font-size:19px}
.tab.on{background:var(--chip);color:var(--accent);font-weight:700}
.t-kuromi .tab.on{background:var(--chip);color:var(--accent)}

/* ---------------- 今日页 ---------------- */
.birthday{margin:4px 20px 0;display:flex;align-items:center;gap:8px;background:linear-gradient(90deg,var(--accent2),var(--accent));color:#fff;border-radius:18px;padding:8px 14px;font-size:13.5px;box-shadow:0 6px 14px rgba(255,109,157,.35);position:relative;z-index:2}
.nextcard{margin:12px 20px 0;padding:15px 16px;position:relative;z-index:2}
.nextcard .nc-top{display:flex;justify-content:space-between;align-items:center}
.nc-time{font-size:30px;color:var(--text);font-weight:700;letter-spacing:1px}
.ear{position:absolute;top:-13px;width:26px;height:30px;background:var(--card);border-radius:50%;z-index:-1}
.ear::after{content:'';position:absolute;inset:7px 8px 10px;background:var(--chip);border-radius:50%}
.ear.l{left:26px;transform:rotate(-16deg)}
.ear.r{right:26px;transform:rotate(16deg)}
.nc-info{margin-top:8px;font-size:14.5px;color:var(--text)}
.nc-info .st{color:var(--sub);font-size:12.5px;margin-top:3px}
.nc-cd{display:flex;flex-direction:column;align-items:center;gap:4px}
.nc-cd .num{font-size:13px;color:var(--sub)}
.cdchip{background:var(--accent);color:#fff;border-radius:20px;padding:5px 13px;font-size:13px;box-shadow:0 4px 10px rgba(255,109,157,.35)}
.lList{margin:12px 20px 0;position:relative;z-index:2}
.lrow{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:20px;margin-bottom:9px;background:var(--card);box-shadow:0 4px 12px rgba(150,100,125,.08)}
.lrow .lt{font-size:15px;font-weight:700;color:var(--text);width:46px}
.lrow .av{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.lrow .li{flex:1;min-width:0}
.lrow .nm{font-size:14.5px;color:var(--text);font-weight:700}
.lrow .pc{font-size:12px;color:var(--sub);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lrow.done{opacity:.5}
.lrow.done .nm{text-decoration:line-through}
.lrow .st-chip{font-size:11.5px;border-radius:16px;padding:3px 9px;background:var(--chip);color:var(--text);flex-shrink:0}
.lrow .st-chip.now{background:var(--accent);color:#fff}

/* ---------------- 周课表 ---------------- */
.days{display:flex;gap:7px;padding:8px 20px 4px;position:relative;z-index:2}
.day{flex:1;text-align:center;border-radius:16px;padding:7px 0 6px;background:var(--card);color:var(--sub);font-size:12.5px;box-shadow:0 3px 8px rgba(150,100,125,.07)}
.day b{display:block;font-size:15px;color:var(--text)}
.day.today{background:var(--accent);color:#ffe3ec}
.day.today b{color:#fff}
.week{margin:12px 20px 0;position:relative;z-index:2;overflow:hidden}
.wrow{display:flex;align-items:center;gap:10px;padding:10px 13px;border-radius:18px;margin-bottom:8px;background:var(--card);box-shadow:0 3px 10px rgba(150,100,125,.07)}
.wrow .wd{width:56px;text-align:center;flex-shrink:0}
.wrow .wd .n{font-size:15px;font-weight:700;color:var(--text)}
.wrow .wd .d{font-size:11px;color:var(--sub)}
.wrow.today{background:linear-gradient(90deg,#fff0f4,#ffe0eb);outline:2px solid var(--accent)}
.wchips{display:flex;flex-wrap:wrap;gap:6px}
.wchip{font-size:11.5px;color:var(--text);background:var(--c,#ffe3ec);border-radius:14px;padding:4px 9px}
.wchip b{color:var(--accent)}
.wrow .busy{margin-left:auto;font-size:11px;color:#fff;background:#ffb14d;border-radius:12px;padding:2px 8px;flex-shrink:0}

/* ---------------- 学生页 ---------------- */
.search{margin:8px 20px 0;background:var(--card);border-radius:20px;padding:9px 15px;font-size:13.5px;color:var(--sub);position:relative;z-index:2;box-shadow:0 4px 10px rgba(120,160,200,.10)}
.slist{margin:12px 20px 0;position:relative;z-index:2}
.scard{padding:13px 14px;border-radius:22px;margin-bottom:11px;background:var(--card);box-shadow:0 5px 14px rgba(120,160,200,.10)}
.scard .top{display:flex;align-items:center;gap:11px}
.scard .av{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.scard .nm{font-size:16px;color:var(--text);font-weight:700}
.scard .chips{margin-top:5px;display:flex;gap:5px}
.scard .chips span{font-size:10.5px;background:var(--chip);color:var(--text);border-radius:12px;padding:2px 8px}
.scard .song{margin-top:9px;font-size:12.5px;color:var(--text);background:var(--bg1);border-radius:14px;padding:6px 11px}
.scard .meta{margin-top:8px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--sub)}
.hearts{color:#ff6d9d;letter-spacing:2px}
.hearts .off{color:#e5d5dd}

/* ---------------- 主题页 ---------------- */
.tlabel{margin:14px 22px 8px;font-size:14px;color:var(--text);font-weight:700;position:relative;z-index:2}
.tgrid{margin:0 20px;display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative;z-index:2}
.tcard{border-radius:20px;padding:10px;display:flex;align-items:center;gap:10px;background:var(--card);box-shadow:0 5px 14px rgba(150,100,125,.10);position:relative;outline:2.5px solid transparent}
.tcard.sel{outline-color:var(--accent)}
.tcard .img{width:52px;height:52px;border-radius:14px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.tcard .img img{width:100%;height:100%;object-fit:cover}
.tcard .tn{font-size:14px;color:var(--text);font-weight:700}
.tcard .td{font-size:10.5px;color:var(--sub);margin-top:2px}
.tcard .ck{position:absolute;top:8px;right:8px;width:20px;height:20px;border-radius:50%;background:var(--accent);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center}
.wgrid{margin:0 20px;display:grid;grid-template-columns:repeat(3,1fr);gap:9px;position:relative;z-index:2}
.wthumb{border-radius:16px;overflow:hidden;position:relative;aspect-ratio:9/15;box-shadow:0 4px 12px rgba(150,100,125,.12)}
.wthumb img{width:100%;height:100%;object-fit:cover;display:block}
.wthumb .using{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-size:10px;border-radius:12px;padding:2px 9px;white-space:nowrap}
.thint{margin:14px 22px 0;font-size:12px;color:var(--sub);text-align:center;position:relative;z-index:2}

/* ---------------- PWA 三兄弟 ---------------- */
.urlbar{
  margin-top:auto;position:relative;z-index:5;background:#f2f2f7;
  padding:9px 14px 22px;display:flex;align-items:center;gap:8px;
}
.urlbar .ub{flex:1;background:#fff;border-radius:12px;padding:8px 12px;font-size:13px;color:#333;display:flex;align-items:center;gap:6px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.urlbar .tools{display:flex;gap:16px;font-size:17px;color:#007aff;padding:0 4px}
.homewall{position:absolute;inset:0;background:url('assets/wall_melody_face.jpg') center/cover;z-index:0}
.homewall::after{content:'';position:absolute;inset:0;background:rgba(255,182,205,.18)}
.hs{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;padding:52px 18px 0}
.hs .searchpill{align-self:center;background:rgba(255,255,255,.55);border-radius:20px;padding:5px 18px;font-size:12px;color:#7c4258;margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 6px;justify-items:center}
.appitem{display:flex;flex-direction:column;align-items:center;gap:4px;width:64px}
.appicon{width:56px;height:56px;border-radius:15px;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 6px 14px rgba(120,70,95,.25);position:relative}
.appitem .lb{font-size:10.5px;color:#fff;text-shadow:0 1px 3px rgba(120,60,90,.7)}
.appicon.mine{background:linear-gradient(145deg,#ff9fbd,#ff5f96)}
.appicon.mine::after{content:'🎀';position:absolute;top:-7px;right:-7px;font-size:15px;filter:drop-shadow(0 2px 3px rgba(200,60,110,.5))}
.appitem.mine .appicon{outline:3px solid #fff;outline-offset:2px;animation:none}
.mineflag{position:absolute;top:-24px;left:50%;transform:translateX(-50%);background:#ff4d88;color:#fff;font-size:10px;border-radius:10px;padding:2px 8px;white-space:nowrap}
.dock{margin-top:auto;margin-bottom:14px;background:rgba(255,255,255,.45);border-radius:26px;padding:9px 10px;display:grid;grid-template-columns:repeat(4,1fr);gap:6px;justify-items:center}

/* 壁纸格里的渐变缩略图 */
.wthumb.grad1{background:linear-gradient(160deg,#ffe0eb,#ffc3da)}
.wthumb.grad2{background:linear-gradient(160deg,#fff3f4,#ffccd6)}
.wthumb.grad3{background:linear-gradient(160deg,#2e2837,#5c4a78)}
.wthumb.grad4{background:linear-gradient(160deg,#e7f3fe,#b8dbf8)}

footer{margin-top:56px;text-align:center;font-size:14px;color:#cfb3c2;line-height:2}
footer .big{font-size:17px;color:#ffc3da}
</style>
</head>
<body>
<div class="wrap">

<div class="hero">
  <h1><span class="violin">🎻</span> 琴琴课表 <span style="font-size:22px">🎀</span></h1>
  <p>给小提琴老师的专属课表 App · 美乐蒂 / 凯蒂猫主题 · 8.30 生日快乐 🎂</p>
</div>

<!-- ============ PART 1: PWA 是什么 ============ -->
<div class="sec">
  <div class="sec-t">① 什么是 PWA？—— 三张图看懂：它就是一个「可以装到桌面上的网页 App」</div>
  <div class="sec-s">不用 App Store、不用账号密码、不用越狱，iPhone 自带功能就能装；以后更新了刷新一下就是新版本</div>
  <div class="row">

    <div class="item">
      <div class="phone"><div class="island"></div>
        <div class="screen t-melody">
          <div class="sb"><span>9:41</span><span class="ic">🛜 🔋</span></div>
          <div class="pagehead">
            <div><div class="dt">8月30日 星期日 · 教师节快乐呀</div><h2>今日课程</h2></div>
            <div class="sticker"><svg width="46" height="46" viewBox="0 0 120 120">
              <ellipse cx="32" cy="12" rx="11" ry="20" fill="#fff" stroke="#f3a7c3" stroke-width="3" transform="rotate(-20 32 12)"/>
              <ellipse cx="88" cy="12" rx="11" ry="20" fill="#fff" stroke="#f3a7c3" stroke-width="3" transform="rotate(20 88 12)"/>
              <circle cx="60" cy="62" r="44" fill="#ffb9d4"/>
              <ellipse cx="60" cy="76" rx="33" ry="25" fill="#fff"/>
              <circle cx="46" cy="73" r="4.5" fill="#5b4037"/><circle cx="74" cy="73" r="4.5" fill="#5b4037"/>
              <ellipse cx="60" cy="84" rx="6" ry="4.5" fill="#ffd44d"/>
              <g stroke="#e8938f" stroke-width="2.5" stroke-linecap="round">
                <line x1="20" y1="76" x2="31" y2="74"/><line x1="20" y1="84" x2="31" y2="83"/>
                <line x1="100" y1="76" x2="89" y2="74"/><line x1="100" y1="84" x2="89" y2="83"/>
              </g>
              <ellipse cx="35" cy="84" rx="6" ry="3.5" fill="#ffc9d8"/><ellipse cx="85" cy="84" rx="6" ry="3.5" fill="#ffc9d8"/>
              <g transform="translate(60 20)"><path d="M0 0 L-15 -9 L-15 9 Z" fill="#ff7fae"/><path d="M0 0 L15 -9 L15 9 Z" fill="#ff7fae"/><circle r="5" fill="#ff5c96"/></g>
            </svg></div>
          </div>
          <div class="birthday">🎂 生日快乐呀 · 今天只上半天课，下午去吃好吃的！</div>
          <div class="card nextcard"><span class="ear l"></span><span class="ear r"></span>
            <div class="nc-top">
              <div><div class="nc-time">10:30</div><div class="nc-info">果果 · 小提琴课<div class="st">《开塞 No.2》 · 英皇3级</div></div></div>
              <div class="nc-cd"><span class="num">还有</span><span class="cdchip">25 分钟 ♪</span></div>
            </div>
          </div>
          <div class="lList">
            <div class="lrow done"><div class="lt">9:00</div><div class="av" style="background:#ffe3ec">🐰</div><div class="li"><div class="nm">小雨</div><div class="pc">沃尔法特 No.12</div></div><span class="st-chip">已上完 ✓</span></div>
            <div class="lrow"><div class="lt">10:30</div><div class="av" style="background:#ffe9d6">🐻</div><div class="li"><div class="nm">果果</div><div class="pc">开塞 No.2</div></div><span class="st-chip now">下一位</span></div>
            <div class="lrow"><div class="lt">14:00</div><div class="av" style="background:#e3f2ff">🐱</div><div class="li"><div class="nm">桃桃</div><div class="pc">铃木① 小星星变奏</div></div><span class="st-chip">3 小时后</span></div>
            <div class="lrow"><div class="lt">16:00</div><div class="av" style="background:#e8ffe3">🐶</div><div class="li"><div class="nm">豆豆</div><div class="pc">塞茨 协奏曲</div></div><span class="st-chip">5 小时后</span></div>
          </div>
          <div class="tabbar">
            <div class="tab on"><span class="ti">🏠</span>今日</div>
            <div class="tab"><span class="ti">🗓️</span>周课表</div>
            <div class="tab"><span class="ti">🎀</span>学生</div>
            <div class="tab"><span class="ti">🎨</span>主题</div>
          </div>
          <div class="urlbar">
            <div class="ub">🔒 &nbsp;qinqin.app</div>
            <div class="tools"><span>‹</span><span>›</span><span>⇧</span><span>❐</span></div>
          </div>
        </div>
        <div class="homebar" style="display:none"></div>
      </div>
      <h3>🖼️ 在 Safari 里打开时</h3>
      <p>本质上是一个网址，底部有地址栏，跟普通网页一样</p>
    </div>

    <div class="item">
      <div class="phone"><div class="island"></div>
        <div class="screen t-melody" style="background:#fcd8e4">
          <div class="homewall"></div>
          <div class="sb" style="color:#7c4258"><span>9:41</span><span class="ic">🛜 🔋</span></div>
          <div class="hs">
            <div class="searchpill">🔍 &nbsp;搜索</div>
            <div class="grid">
              <div class="appitem"><div class="appicon" style="background:#63c76a">💬</div><span class="lb">微信</span></div>
              <div class="appitem"><div class="appicon" style="background:#5aa9e6">📞</div><span class="lb">电话</span></div>
              <div class="appitem"><div class="appicon" style="background:#ffb14d">📷</div><span class="lb">相机</span></div>
              <div class="appitem"><div class="appicon" style="background:#b98ae0">🎵</div><span class="lb">音乐</span></div>
              <div class="appitem"><div class="appicon" style="background:#ff8f6d">📚</div><span class="lb">备忘录</span></div>
              <div class="appitem"><div class="appicon" style="background:#7ecbb5">🛒</div><span class="lb">淘宝</span></div>
              <div class="appitem"><div class="appicon" style="background:#f28ab2">🎬</div><span class="lb">红果</span></div>
              <div class="appitem"><div class="appicon" style="background:#8fb8f2">🕐</div><span class="lb">时钟</span></div>
              <div class="appitem"><div class="appicon" style="background:#ffd44d">📓</div><span class="lb">日历</span></div>
              <div class="appitem mine">
                <span class="mineflag">👆 分享 → 添加到主屏幕</span>
                <div class="appicon mine">🎻</div><span class="lb">琴琴课表</span>
              </div>
              <div class="appitem"><div class="appicon" style="background:#a0d468">🧘</div><span class="lb">健康</span></div>
              <div class="appitem"><div class="appicon" style="background:#e0a9f2">🛍️</div><span class="lb">设置</span></div>
            </div>
            <div class="dock">
